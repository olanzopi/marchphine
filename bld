#!/bin/bash

case "$1" in
    run)
        rm build/linux/marchphine
        cmake --build --preset linux . -j16
        cd build/linux
        ./marchphine
	;;
    build)
        echo "starting linux build"
        cmake --build --preset linux -j16
        echo "starting windows build"
        cmake --build --preset windows -j16
        ;;
    *)
        echo "usage: $0 {run|build}"
        exit 1
        ;;
esac
